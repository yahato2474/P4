#!/usr/bin/env python3
import sys
import grpc
import os
from p4runtime_lib.switch import ShutdownAllSwitchConnections
import p4runtime_lib.bmv2
import p4runtime_lib.helper

# 1. P4InfoファイルとJSONファイルのパス
P4INFO_FILE_PATH = "build/basic.p4.p4info.txt"
BMV2_JSON_FILE_PATH = "build/basic.json"

def read_register():
    # 2. P4Runtime helperをロード
    p4info_helper = p4runtime_lib.helper.P4InfoHelper(P4INFO_FILE_PATH)

    # 3. スイッチに接続 (s1: thrift=9090, grpc=50051)
    s1 = p4runtime_lib.bmv2.Bmv2SwitchConnection(
        name='s1',
        address='127.0.0.1:50051',
        device_id=0,
        proto_dump_file='logs/s1-p4runtime.log'
    )

    # 4. Masterとして接続開始
    s1.MasterArbitrationUpdate()

    # 5. Registerを読み取る
    print("[*] Reading register values from MyIngress.test_counter")
    results = s1.ReadRegisters(p4info_helper.get_registers_id('MyIngress.test_counter'))

    # 6. 結果を表示
    for entity in results:
        register = entity.register_entry
        index = register.index.index
        value = int.from_bytes(register.data[0].value, byteorder='big')
        print(f"  index {index}: value = {value}")

    # 7. 終了処理
    ShutdownAllSwitchConnections()

if __name__ == '__main__':
    read_register()

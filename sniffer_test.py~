from scapy.all import sniff, IP
import threading
import time

hosts = {}

def packet_sniffer():
    print("[*] Sniffer起動中（Ctrl+Cで停止）...")
    sniff(filter = "ip", prn = handle_packet, store = 0)

def handle_packet(pkt):
    if IP in pkt:
        src = pkt[IP].src
        dst = pkt[IP].dst
        key = (src,dst)
        if key not in hosts:
            hosrs[key] = True
            print(f"[Sniffer] 新しい通信ペアを発見: {src} → {dst}")

def register_monitor():
    while True:
        print("[Monitor] Register監視中...")
        # ここに register 読み出し処理を入れる想定
        time.sleep(2)

if __name__ == "__main__":
    print("[*] Snifferスレッドを開始します...")
    t = threading.Thread(target=packet_sniffer, daemon=True)
    t.start()

